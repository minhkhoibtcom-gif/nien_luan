# Chép file này thành .streamlit/secrets.toml (không đưa lên git) hoặc dán nội dung vào
# Streamlit Cloud: trang quản lý app -> Settings -> Secrets.

# Tài khoản admin tạo lần đầu chạy app (bỏ trống thì dùng admin@fastbite.vn / Admin@123)
[admin]
email = "admin@fastbite.vn"
password = "doi-mat-khau-nay"

# PostgreSQL (Supabase, Neon...) để dữ liệu không mất khi app khởi động lại.
# Bỏ cả mục này thì app dùng SQLite users.db như khi chạy trên máy.
# Supabase: Project -> Connect -> "Session pooler" (chạy được trên mạng IPv4 như Streamlit Cloud), thay [YOUR-PASSWORD].
[postgres]
url = "postgresql://postgres.xxxxxxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
